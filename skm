def cmd_init(argv):
    harden_memory()
    if IDENTITY.exists():
        die(f"a vault already exists in {VAULT} (delete it by hand to start over)")
    VAULT.mkdir(mode=0o700, parents=True, exist_ok=True)
    PROFILES.mkdir(mode=0o700, parents=True, exist_ok=True)
    VAULT.chmod(0o700)

    passphrase = ask_passphrase(
        "skm: create the vault",
        "Choose the passphrase that will protect ALL your API keys.\n\n"
        "It is stored nowhere and no agent can read it.\n"
        "If you lose it, the vault cannot be recovered.",
        confirm=True,
    )

    kg = subprocess.run([find_tool("age-keygen")], capture_output=True, env=age_env())
    if kg.returncode != 0:
        die("age-keygen failed: " + kg.stderr.decode())
    lines = kg.stdout.decode().splitlines()
    secret = next(l for l in lines if l.startswith("AGE-SECRET-KEY"))
    pub = next(l for l in lines if "public key:" in l).split(": ", 1)[1].strip()

    enc = run_age(["-e", "-j", "batchpass", "-a"], inp=secret.encode(),
                  passphrase=passphrase)
    del passphrase, secret
    if enc.returncode != 0:
        die("could not encrypt the identity: " + enc.stderr.decode())

    # The identity last: until it exists, a crash leaves `skm init` free to retry.
    write_private(RECIPIENT, (pub + "\n").encode(), 0o444)
    write_private(CONFIG, (json.dumps({
        "version": VERSION,
        "created": time.strftime("%Y-%m-%d"),
    }, indent=2) + "\n").encode())
    write_private(VAULT / ".gitignore", b"*\n")
    write_private(IDENTITY, enc.stdout, 0o400)

    audit("init", recipient=pub)
    print(f"Vault created in {VAULT}")
    print(f"Public key (not secret): {pub}")
    print("\nAdd your first key:  skm add openai OPENAI_API_KEY")


def cmd_add(argv):
    harden_memory()
    require_vault()
    if len(argv) != 2:
        die("usage: skm add <profile> <VARIABLE>", EX_USAGE)
    profile, key = argv
    check_key(key)
    if is_reserved(key):
        die(f"{key} is reserved: setting it could make the approved command run other "
            "code.\n     Store the value under another name.", EX_USAGE)
    d = profile_dir(profile)
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    target = d / f"{key}.age"
    existed = target.exists()

    value = ask_value(
        "skm: new secret value",
        f"Profile: {profile}\nVariable: {key}\n"
        + ("\nWARNING: this variable exists and will be REPLACED.\n" if existed else "")
        + f"\nRequested by: {caller_chain()}\n"
        + f"Encrypted to: {printable(recipient())}\n"
        + "\nThe value is masked and never appears in the agent's conversation.",
    )
    if not value:
        die("empty value, nothing was stored", EX_USAGE)
    if len(value) < MIN_SECRET:
        die(f"value too short to be scrubbed ({MIN_SECRET} characters minimum), "
            "nothing was stored", EX_USAGE)

    r = run_age(["-e", "-r", recipient(), "-a"], inp=value.encode())
    del value
    if r.returncode != 0:
        die("encryption failed: " + r.stderr.decode())
    write_private(target, r.stdout)
    audit("add", profile=profile, key=key, replaced=existed)
    notify("skm: secret stored", f"{profile}/{key}")
    print(f"{'Replaced' if existed else 'Added'}: {profile}/{key}")
    print("(no passphrase is needed to store a value; the vault stays unreadable)")


def cmd_ls(argv):
