VERSION = "1.4.1"

# From the password database: HOME is set by the caller.
REAL_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
DEFAULT_VAULT = REAL_HOME / ".secretvault"
VAULT = Path(os.environ.get("SKM_VAULT", DEFAULT_VAULT))
PROFILES = VAULT / "profiles"
IDENTITY = VAULT / "identity.age"
RECIPIENT = VAULT / "recipient.txt"
AUDIT = VAULT / "audit.log"
CONFIG = VAULT / "config.json"

# zenity --forms field separator. The default "|" truncated any value holding one.
ZENITY_SEP = "\x1f"

PROMPT_TIMEOUT = 180  # seconds a person has to answer an approval prompt
MIN_PASSPHRASE = 12
MIN_SECRET = 4  # shorter values could not be scrubbed without mangling output
MAX_SHOWN_COMMAND = 700

# The agent socket lives in the session runtime directory (tmpfs, 0700, cleared at
# logout) rather than in the vault, so an agent cannot survive a reboot.
_RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
AGENT_SOCK = Path(os.environ.get("SKM_AGENT_SOCK", _RUNTIME / "skm-agent.sock"))
AGENT_PID = AGENT_SOCK.with_name(AGENT_SOCK.name + ".pid")
AGENT_TTL = 900  # 15 minutes
AGENT_TTL_MIN, AGENT_TTL_MAX = 60, 28800

REDACTED = "[SKM:REDACTED]"
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
PROFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# Names a stored value must never set, and that the caller's environment may not
# pass to the command: each can make it run other code or send its traffic
# elsewhere, with the real secrets in reach.
RESERVED_NAMES = {
    "PATH", "HOME", "IFS", "ENV", "BASH_ENV", "ZDOTDIR", "SHELL", "SHELLOPTS",
    "BASHOPTS", "PROMPT_COMMAND", "PS4", "CDPATH", "NODE_OPTIONS", "NODE_PATH",
    "GCONV_PATH", "GETCONF_DIR", "GLIBC_TUNABLES", "NLSPATH", "LOCPATH", "TERMINFO",
    "HOSTALIASES", "LOCALDOMAIN", "RES_OPTIONS", "TMPDIR", "EDITOR", "VISUAL",
    "PAGER", "BROWSER", "LESSOPEN", "LESSCLOSE", "OPENSSL_CONF", "MAKEFLAGS",
    "RUSTC_WRAPPER", "JDK_JAVA_OPTIONS", "MAVEN_OPTS", "GRADLE_OPTS", "LUA_INIT",
    "PHPRC", "PIP_INDEX_URL", "PIP_EXTRA_INDEX_URL", "CURL_HOME", "CURL_CA_BUNDLE",
    "SSL_CERT_FILE", "SSL_CERT_DIR", "REQUESTS_CA_BUNDLE", "NODE_EXTRA_CA_CERTS",
    "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "DOCKER_HOST", "KUBECONFIG",
}
RESERVED_PREFIXES = (
    "LD_", "DYLD_", "PYTHON", "PERL", "RUBY", "JAVA_TOOL", "_JAVA", "GIT_", "SKM_",
    "BASH_FUNC_", "NPM_CONFIG_", "CARGO_", "XDG_",
)
# Reserved, but ordinary programs need them from the caller's environment.
KEEP_INHERITED = {"PATH", "HOME", "SHELL", "TMPDIR", "EDITOR", "VISUAL", "PAGER", "BROWSER"}
KEEP_INHERITED_PREFIXES = ("XDG_",)
# Removed like the others, but distributions set them in every shell: naming them
# on each run would only teach people to ignore the note.
QUIET_DROPPED = {"LESSOPEN", "LESSCLOSE"}
# What skm's own tools (age, zenity, ...) receive from the caller.
TOOL_ENV = {
    "HOME", "USER", "LOGNAME", "LANG", "LANGUAGE", "TERM", "DISPLAY", "WAYLAND_DISPLAY",
    "XAUTHORITY", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
    "DBUS_SESSION_BUS_ADDRESS",
}

EX_USAGE = 2
EX_UNKNOWN = 3  # no vault, profile or variable of that name
EX_REFUSED = 77  # the person refused, or the prompt timed out
EX_NO_UI = 78  # neither a graphical session nor a terminal to ask in
EX_BAD_PASSPHRASE = 79
EX_CANNOT_RUN = 126
EX_NOT_FOUND = 127

# ------------------------------------------------------------------ utilities


def die(msg: str, code: int = 1):
    print(f"skm: {msg}", file=sys.stderr)
    sys.exit(code)


def printable(text: str) -> str:
    """Show control characters as \\xNN: no value may add lines to a prompt or
    send escape sequences to a terminal."""
    return "".join(c if c.isprintable() else f"\\x{ord(c):02x}" for c in text)


def trusted_dirs() -> list[str]:
    """Where skm looks for its tools. Never the caller's PATH: a fake `age` first in
    PATH would receive the passphrase from behind a genuine prompt."""
    here = Path(__file__)
    dirs = [here.absolute().parent, here.resolve().parent, REAL_HOME / ".local/bin",
            Path("/usr/local/bin"), Path("/usr/bin"), Path("/bin")]
    return list(dict.fromkeys(str(d) for d in dirs))


def which_tool(name: str) -> str | None:
    return shutil.which(name, path=os.pathsep.join(trusted_dirs()))


def find_tool(name: str) -> str:
    found = which_tool(name)
    if found:
        return found
    die(f"required tool not found: {name} (looked in {', '.join(trusted_dirs())})",
        EX_NOT_FOUND)


def tool_env() -> dict:
    """A minimal environment for skm's own tools: LD_PRELOAD or GTK_MODULES would
    otherwise load code into the window that reads the passphrase."""
    env = {k: v for k, v in os.environ.items() if k in TOOL_ENV or k.startswith("LC_")}
    env["PATH"] = os.pathsep.join(trusted_dirs())
    return env


def age_env() -> dict:
    """Tool environment, with `age`'s own directory for its age-plugin-batchpass."""
    env = tool_env()
    age_dir = Path(find_tool("age")).resolve().parent
    env["PATH"] = str(age_dir) + os.pathsep + env["PATH"]
    return env


def run_age(args: list[str], inp: bytes | None = None, passphrase: str | None = None):
    """Run age. The passphrase goes through a file descriptor, never through argv
    (visible in ps) nor the broker's environment."""
    env = age_env()
    pass_fds: tuple[int, ...] = ()
    rfd = None
    if passphrase is not None:
        rfd, wfd = os.pipe()
        os.write(wfd, passphrase.encode())
        os.close(wfd)
        env["AGE_PASSPHRASE_FD"] = str(rfd)
        pass_fds = (rfd,)
    try:
        return subprocess.run(
            [find_tool("age"), *args],
            input=inp,
            capture_output=True,
            env=env,
            pass_fds=pass_fds,
        )
    finally:
        if rfd is not None:
            os.close(rfd)


def write_private(path: Path, data: bytes, mode: int = 0o600):
    """Atomic write: at any moment one complete version exists, never world-readable."""
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
            os.fchmod(fh.fileno(), mode)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def have_gui() -> bool:
    return bool(
        os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")
    ) and bool(which_tool("zenity"))


def notify(title: str, body: str, urgency: str = "normal"):
    tool = which_tool("notify-send")
    if tool:
        subprocess.run(
            [tool, "-u", urgency, "-a", "skm", title, body],
            capture_output=True, env=tool_env(),
        )


def caller_chain(depth: int = 4, start: int | None = None) -> str:
    """Walk up the parent processes: who is asking for the secret?

    `start` lets the agent describe the process querying it rather than its own
    parent (init, since it is daemonized)."""
    names, pid = [], os.getppid() if start is None else start
    for _ in range(depth):
        try:
            names.append(printable(Path(f"/proc/{pid}/comm").read_text().strip()))
            # rsplit: a process name may itself contain ") ".
            pid = int(
                Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[1]
            )
            if pid <= 1:
                break
        except Exception:
            break
    return " <- ".join(names) if names else "unknown"


def zenity_text(text: str) -> str:
    """Make text literal for --text, which zenity reads as Pango markup with
    backslash escapes. Otherwise a `&` empties the approval prompt, and a <span>
    or a `\\n` in a command can hide or imitate part of it."""
    return html.escape(text, quote=False).replace("\\", "\\\\")


def terminal_input(label: str) -> str:
    """Masked input in the terminal, with a time limit like the window's."""
    import getpass

    def timed_out(*_):
        die("refused by the user, or the prompt timed out", EX_REFUSED)

    signal.signal(signal.SIGALRM, timed_out)
    signal.alarm(PROMPT_TIMEOUT)
    try:
        return getpass.getpass(label)
    finally:
        signal.alarm(0)


TERMINAL_WARNING = (
    "WARNING: no graphical window is available, so skm is asking in this terminal.\n"
    "Type here only if YOU started this command in your own terminal. If an AI agent\n"
    "started it, press Ctrl-C: the agent can read what you type here.\n"
)


def ask_passphrase(title: str, detail: str, confirm: bool = False) -> str:
    """Ask for the passphrase in a MASKED field. This is the one barrier an agent
    cannot cross: it can neither read nor type the passphrase."""
    if have_gui():
        args = [
            find_tool("zenity"), "--forms", f"--separator={ZENITY_SEP}",
            f"--title={title}",
            f"--text={zenity_text(detail)}",
            "--add-password=Vault passphrase",
        ]
        if confirm:
            args.append("--add-password=Confirm passphrase")
        # --height bounds the window: without it, zenity --forms grows with the
        # text and pushes the input field off the screen.
        args += [f"--timeout={PROMPT_TIMEOUT}", "--width=560", "--height=440"]
        r = subprocess.run(args, capture_output=True, text=True, env=tool_env())
        if r.returncode != 0:
            audit("prompt_refused")
            die("refused by the user, or the prompt timed out", EX_REFUSED)
        parts = r.stdout.rstrip("\n").split(ZENITY_SEP)
        if confirm and (len(parts) < 2 or parts[0] != parts[1]):
            die("the two passphrases differ, nothing was changed")
        passphrase = parts[0]
    else:
        if not sys.stdin.isatty():
            die(
                "no graphical session and no terminal, so skm cannot ask for approval.\n"
                "     This is deliberate: an agent alone must not be able to unlock the "
                "vault.\n     Ask the person to run this command themselves.",
                EX_NO_UI,
            )
        print(f"\n{title}\n{detail}\n\n{TERMINAL_WARNING}", file=sys.stderr)
        passphrase = terminal_input("Vault passphrase: ")
        if confirm and passphrase != terminal_input("Confirm passphrase: "):
            die("the two passphrases differ, nothing was changed")
    if confirm and len(passphrase) < MIN_PASSPHRASE:
        die(f"passphrase too short ({MIN_PASSPHRASE} characters minimum), nothing was changed")
    return passphrase


def ask_value(title: str, detail: str) -> str:
    """Read a secret value in a masked field, outside the agent's context."""
    if have_gui():
        r = subprocess.run(
            [find_tool("zenity"), "--forms", f"--separator={ZENITY_SEP}",
             f"--title={title}", f"--text={zenity_text(detail)}",
             "--add-password=Secret value", "--timeout=300", "--width=520"],
            capture_output=True, text=True, env=tool_env(),
        )
        if r.returncode != 0:
            die("input cancelled, nothing was stored", EX_REFUSED)
        return r.stdout.rstrip("\n").split(ZENITY_SEP)[0]
    if not sys.stdin.isatty():
        die("no graphical session and no terminal to type the value in.\n"
            "     Ask the person to run this command themselves.", EX_NO_UI)
    print(f"\n{title}\n{detail}\n\n{TERMINAL_WARNING}", file=sys.stderr)
    return terminal_input("Secret value: ")


_audit_warned = False


def audit(action: str, **fields) -> bool:
    """Returns False if the entry could not be written."""
    global _audit_warned
    rec = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "action": action,
        "pid": os.getpid(),
        "caller": caller_chain(),
        **fields,
    }
    try:
        AUDIT.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
        return True
    except Exception as exc:
        # A log that silently stops is worse than a noisy one.
        if not _audit_warned:
            print(f"skm: warning: cannot write the audit log: {exc}", file=sys.stderr)
            _audit_warned = True
        return False


def vault_ready() -> bool:
    return IDENTITY.is_file() and RECIPIENT.is_file()


def require_vault():
    if not vault_ready():
        die("no vault here yet. Ask the person to run: skm init", EX_UNKNOWN)


def recipient() -> str:
    return RECIPIENT.read_text().strip()


def profile_dir(name: str) -> Path:
    if not PROFILE_RE.match(name):
        die(f"invalid profile name: {name!r}", EX_USAGE)
    return PROFILES / name


def check_key(name: str):
    """Variable names become file names: this also blocks `../` paths."""
    if not KEY_RE.match(name):
        die(f"invalid variable name: {name!r} "
            "(expected letters, digits and underscores)", EX_USAGE)


def is_reserved(name: str) -> bool:
    """Anything that is not a plain variable name counts: BASH_FUNC_x%% defines a
    shell function in every bash the command starts."""
    upper = name.upper()
    return (not KEY_RE.match(name) or upper in RESERVED_NAMES
            or upper.startswith(RESERVED_PREFIXES))


def key_names(profile: str) -> list[str]:
    d = profile_dir(profile)
    return sorted(p.stem for p in d.glob("*.age")) if d.is_dir() else []


def all_profiles() -> list[str]:
    if not PROFILES.is_dir():
        return []
    return sorted(p.name for p in PROFILES.iterdir() if p.is_dir())


def check_age_setup():
    """After a failed decryption: was it something other than the passphrase?"""
    age_dir = Path(find_tool("age")).resolve().parent
    if not (age_dir / "age-plugin-batchpass").is_file() and not which_tool("age-plugin-batchpass"):
        die("age-plugin-batchpass is missing, so skm cannot decrypt the vault. "
            "Your passphrase may be fine.", EX_NOT_FOUND)
    if b"BEGIN AGE ENCRYPTED FILE" not in IDENTITY.read_bytes()[:40]:
        die(f"{IDENTITY} is not an encrypted identity file: it looks damaged. "
            "Your passphrase may be fine.")


def unlock(detail: str) -> str:
    """Unlock the age identity. Returns the private key, in memory only."""
    passphrase = ask_passphrase("skm: approval required", detail)
    r = run_age(["-d", "-j", "batchpass"], inp=IDENTITY.read_bytes(), passphrase=passphrase)
    del passphrase
    if r.returncode != 0:
        check_age_setup()
        audit("unlock_failed")
        notify("skm: access refused", "Wrong passphrase", "critical")
        die("wrong passphrase", EX_BAD_PASSPHRASE)
    return r.stdout.decode().strip()


def decrypt_keys(profile: str, identity: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for kf in sorted(profile_dir(profile).glob("*.age")):
        if is_reserved(kf.stem):
            continue  # planted by hand: skm add refuses these names
        rfd, wfd = os.pipe()
        os.write(wfd, (identity + "\n").encode())
        os.close(wfd)
        try:
            r = subprocess.run(
                [find_tool("age"), "-d", "-i", f"/dev/fd/{rfd}"],
                input=kf.read_bytes(), capture_output=True,
                env=age_env(), pass_fds=(rfd,),
            )
        finally:
            os.close(rfd)
        if r.returncode != 0:
            die(f"cannot decrypt {profile}/{kf.stem}: "
                f"{r.stderr.decode().strip()}")
        out[kf.stem] = r.stdout.decode().rstrip("\n")
    return out


def harden_memory():
    """No ptrace, no /proc/<pid>/mem, no core dump for this process. The core limit
    is inherited, so a crashing child does not dump its secrets either."""
    try:
        import ctypes

        ctypes.CDLL("libc.so.6", use_errno=True).prctl(4, 0, 0, 0, 0)  # PR_SET_DUMPABLE
    except Exception:
        pass
    try:
        import resource

        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except Exception:
        pass


# ---------------------------------------------------------------------- agent
#
# An accepted trade-off: one passphrase per time window instead of one per use.
# The decrypted identity NEVER leaves the agent process. It returns the decrypted
# values of the requested profile, not the private key, so a compromised client
# gets the secrets it asks for, not the whole vault's key.


def socket_is_ours(path: Path) -> bool:
    """Refuse anything but a socket we own: SKM_AGENT_SOCK is set by the caller."""
    try:
        st = path.lstat()
    except OSError:
        return False
    return stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid()


def _agent_talk(request: str, timeout: float = 10.0) -> str | None:
    """Send a request to the agent. Returns None if there is no usable agent."""
    if not socket_is_ours(AGENT_SOCK):
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(str(AGENT_SOCK))
    except OSError as exc:
        # Orphan socket: the agent died without cleaning up. A timeout only means it
        # is busy, and deleting its socket would make `skm lock` lose it.
        if exc.errno in (errno.ECONNREFUSED, errno.ENOENT):
            try:
                AGENT_SOCK.unlink()
            except OSError:
                pass
        return None
    try:
        s.sendall((request + "\n").encode())
        chunks = []
        while True:
            c = s.recv(65536)
            if not c:
                break
            chunks.append(c)
        return b"".join(chunks).decode()
    except OSError:
        return None
    finally:
        s.close()


def agent_status() -> tuple[int, list[str] | None] | None:
    """(seconds left, allowed profiles or None for all), or None without an agent."""
    resp = _agent_talk("STATUS")
    if not resp or not resp.startswith("OK "):
        return None
    parts = resp.split()
    try:
        left = int(parts[1])
    except (IndexError, ValueError):
        return None
    return left, (parts[2].split(",") if len(parts) > 2 else None)


def agent_remaining() -> int | None:
    status = agent_status()
    return None if status is None else status[0]


def agent_get(profiles: list[str]) -> dict[str, str] | None:
    """Ask the agent for secrets. None means: fall back to the passphrase."""
    resp = _agent_talk("GET " + " ".join(profiles))
    if not resp or not resp.startswith("OK "):
        return None
    try:
        return json.loads(resp[3:])
    except ValueError:
        return None


def boottime() -> float:
    """A clock that keeps counting during suspend: a window must not survive a night
    of sleep, as it would on time.monotonic()."""
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def agent_serve(identity: str, ttl: int, allowed: list[str] | None = None):
    """Service loop. Never returns: the process dies when the window ends."""
    harden_memory()
    deadline = boottime() + ttl

    def terminate(*_):
        sys.exit(0)

    signal.signal(signal.SIGTERM, terminate)

    AGENT_SOCK.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if AGENT_SOCK.exists():
        if not socket_is_ours(AGENT_SOCK):
            os._exit(EX_USAGE)  # never delete a file the caller pointed us at
        AGENT_SOCK.unlink()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old_umask = os.umask(0o177)  # no gap between bind and chmod
    try:
        srv.bind(str(AGENT_SOCK))
    finally:
        os.umask(old_umask)
    AGENT_SOCK.chmod(0o600)
    write_private(AGENT_PID, f"{os.getpid()}\n".encode())
    srv.listen(8)
    srv.settimeout(1.0)

    audit("agent_start", ttl=ttl, sock=str(AGENT_SOCK), allowed=allowed)
    reason = "expired"
    try:
        while boottime() < deadline:
            try:
                conn, _ = srv.accept()
            except (socket.timeout, TimeoutError):
                continue
            except OSError:
                break
            with conn:
                # Without a timeout, a silent client blocked this loop past the
                # deadline and could then still obtain the secrets.
                conn.settimeout(2.0)
                try:
                    raw = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                          struct.calcsize("3i"))
                    peer_pid, peer_uid, _ = struct.unpack("3i", raw)
                except OSError:
                    continue
                # Only your own UID is served. The kernel provides this value, so
                # the client cannot forge it.
                if peer_uid != os.getuid():
                    audit("agent_refused", peer_uid=peer_uid, peer_pid=peer_pid)
                    conn.sendall(b"ERR uid\n")
                    continue
                try:
                    parts = conn.recv(8192).decode().strip().split()
                except OSError:
                    continue
                if not parts:
                    continue
                if boottime() >= deadline:
                    conn.sendall(b"ERR expired\n")
                    break
                verb, args = parts[0].upper(), parts[1:]

                if verb == "STATUS":
                    left = max(0, int(deadline - boottime()))
                    scope = f" {','.join(allowed)}" if allowed else ""
                    conn.sendall(f"OK {left}{scope}\n".encode())
                elif verb == "STOP":
                    audit("agent_stop", peer_pid=peer_pid,
                          caller=caller_chain(start=peer_pid))
                    conn.sendall(b"OK\n")
                    reason = "stop requested"
                    break
                elif verb == "GET" and args:
                    if allowed is not None and not set(args) <= set(allowed):
                        audit("agent_refused", profiles=args, peer_pid=peer_pid,
                              caller=caller_chain(start=peer_pid))
                        conn.sendall(b"ERR scope\n")
                        continue
                    secrets: dict[str, str] = {}
                    bad = None
                    try:
                        for p in args:
                            if not PROFILE_RE.match(p) or not profile_dir(p).is_dir():
                                bad = p
                                break
                            secrets.update(decrypt_keys(p, identity))
                    except (SystemExit, Exception) as exc:
                        # One damaged file must not end the window for the others.
                        audit("agent_error", profiles=args, error=type(exc).__name__)
                        conn.sendall(b"ERR internal\n")
                        continue
                    if bad is not None:
                        conn.sendall(b"ERR profile\n")
                        continue
                    audit("agent_grant", profiles=args, keys=len(secrets),
                          peer_pid=peer_pid, caller=caller_chain(start=peer_pid))
                    notify("skm: secret served by the agent",
                           f"{', '.join(args)} -> {caller_chain(2, start=peer_pid)}")
                    conn.sendall(("OK " + json.dumps(secrets) + "\n").encode())
                    secrets.clear()
                else:
                    conn.sendall(b"ERR request\n")
    finally:
        del identity
        srv.close()
        for path in (AGENT_SOCK, AGENT_PID):
            try:
                path.unlink()
            except OSError:
                pass
        audit("agent_end", reason=reason)
        notify("skm: agent stopped", f"The vault is locked again ({reason}).")
    os._exit(0)


# ------------------------------------------------------------------ scrubbing


def secret_forms(secret: str) -> set[bytes]:
    """The value and the encodings a command is likely to print it in."""
    raw = secret.encode()
    quoted = urllib.parse.quote(secret, safe="")
    forms = {
        raw,
        base64.b64encode(raw),
        base64.urlsafe_b64encode(raw),
        base64.b64encode(raw).rstrip(b"="),
        base64.urlsafe_b64encode(raw).rstrip(b"="),
        raw.hex().encode(),
        raw.hex().upper().encode(),
        quoted.encode(),
        re.sub(r"%[0-9A-F]{2}", lambda m: m.group().lower(), quoted).encode(),
    }
    return {f for f in forms if f}


class Scrubber:
    """Replace every occurrence of a secret in a stream, including one split across
    two reads."""

    def __init__(self, secrets: list[str]):
        forms: set[bytes] = set()
        for s in secrets:
            if len(s) >= MIN_SECRET:
                forms |= secret_forms(s)
        # Longest first, so a secret contained in another leaves no piece behind.
        self.secrets = sorted(forms, key=len, reverse=True)
        self.keep = max((len(s) for s in self.secrets), default=1) - 1
        self.buf = b""

    def feed(self, chunk: bytes) -> bytes:
        self.buf += chunk
        if not self.secrets:
            out, self.buf = self.buf, b""
            return out
        data = self._sub(self.buf)
        if len(data) > self.keep:
            cut = len(data) - self.keep
            out, self.buf = data[:cut], data[cut:]
            return out
        self.buf = data
        return b""

    def flush(self) -> bytes:
        out = self._sub(self.buf)
        self.buf = b""
        return out

    def _sub(self, data: bytes) -> bytes:
        for s in self.secrets:
            data = data.replace(s, REDACTED.encode())
        return data


