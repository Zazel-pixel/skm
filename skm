def cmd_rm(argv):
    harden_memory()
    require_vault()
    if not argv or len(argv) > 2:
        die("usage: skm rm <profile> [VARIABLE]", EX_USAGE)
    profile = argv[0]
    d = profile_dir(profile)
    if len(argv) == 2:
        check_key(argv[1])
    if not d.is_dir():
        die(f"unknown profile: {profile}", EX_UNKNOWN)
    if len(argv) == 2:
        f = d / f"{argv[1]}.age"
        if not f.is_file():
            die(f"unknown variable: {profile}/{argv[1]}", EX_UNKNOWN)
        what = f"{profile}/{argv[1]}"
    else:
        what = f"the whole profile {profile} ({len(key_names(profile))} keys)"
    # Deleting is irreversible, so it needs the same approval as reading.
    identity = unlock(
        f"Permanently delete:\n\n    {what}\n\nRequested by: {caller_chain()}\n\n"
        "Type your passphrase to DELETE, or cancel to refuse."
    )
    del identity
    if len(argv) == 2:
        f.unlink()
        audit("rm", profile=profile, key=argv[1])
    else:
        n = len(key_names(profile))
        shutil.rmtree(d)
        audit("rm_profile", profile=profile, keys=n)
    print(f"Deleted: {what}")


def cmd_show(argv):
    """Show a value IN A WINDOW, never on stdout, so never in the agent's context."""
    harden_memory()
    require_vault()
    if len(argv) != 2:
